# ==============================================================================
# Enterprise Knowledge Assistant — Environment Variables Template (.env.example)
# Copy this file to `.env` and adjust values for your environment.
# Reference: docs/CONTRACTS.md (Section 3: Configuration Contract)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="Enterprise Knowledge Assistant"
API_V1_STR=/api/v1
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 + pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=eka_user
POSTGRES_PASSWORD=eka_password
POSTGRES_DB=eka_db
POSTGRES_PORT=5432

# Local development URL (use @db:5432 inside Docker Compose)
DATABASE_URL=postgresql+psycopg://eka_user:eka_password@localhost:5432/eka_db

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=super-secret-enterprise-jwt-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. AI Providers Selection ("mock" | "openai" | "gemini")
#    Default is "mock" for deterministic offline execution & CI testing
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# OpenAI Provider Settings (required only when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Provider Settings (required only when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ------------------------------------------------------------------------------
# 5. Vector Search, RAG & Guardrail Thresholds (Mandatory Scenarios 1, 2, 3)
# ------------------------------------------------------------------------------
# Unified embedding vector dimension across OpenAI (768), Gemini (768), and Mock (768)
EMBEDDING_DIM=768

# Scenario 1 Abstention Gate: Minimum cosine similarity score [0.0, 1.0]
SIMILARITY_THRESHOLD=0.65

# Default top-k authorized chunks retrieved per query
DEFAULT_TOP_K=5

# Scenario 2 Post-Generation Citation Verifier: Minimum quote token overlap ratio [0.0, 1.0]
QUOTE_OVERLAP_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 6. Document Ingestion & Storage Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Execution mode: "sync" (default immediate readiness) | "background"
INGESTION_MODE=sync

# Automatically seed default departments, demo RBAC users, and sample documents on startup
SEED_ON_STARTUP=true

# ------------------------------------------------------------------------------
# 7. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8000
