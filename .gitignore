# ==============================================================================
# Enterprise Knowledge Assistant — .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.local
.env.*.local
!.env.example

# Python / FastAPI Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Testing & Quality Tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Node / React / TypeScript Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Local Runtime Data & Uploaded Documents
data/uploads/*
!data/uploads/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep
*.db
*.sqlite3

# IDEs, Editors & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
